              "type": "noauth"
            }
          }
        },
        {
          "name": "Protected (any user)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/protected",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "protected"
