{
  "info": {
    "name": "Financial Coach API (Spring Boot)",
    "description": "Endpoints of docs/openapi.yaml.\n\n1. Run **Auth → Login**: it stores accessToken and refreshToken.\n2. Run **Accounts → List accounts**: it stores the first accountId.\n3. Everything else uses those variables. When the access token expires (15 min), run **Auth → Refresh**.\n\nLogin is rate limited to 5 requests per minute per IP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "email",
      "value": "client1@example.local"
    },
    {
      "key": "password",
      "value": "ClientPass123!"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.local"
    },
    {
      "key": "adminPassword",
      "value": "AdminPass123!"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "previousRefreshToken",
      "value": ""
    },
    {
      "key": "accountId",
      "value": "019a0000-0000-7000-8000-000000000101"
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "month",
      "value": "2026-09"
    },
    {
      "key": "recurringTransactionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
