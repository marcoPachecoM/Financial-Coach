# Variables for the Spring Boot backend (backend/). The `dev` profile has defaults for all
# of them, so this file is only needed outside `dev` (see README, section "Configuration").
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=financial-coach-api
JWT_AUDIENCE=financial-coach-clients
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d
DB_URL=jdbc:postgresql://localhost:5432/financial_coach
DB_USER=financial_coach
DB_PASSWORD=financial_coach
CORS_ALLOWED_ORIGINS=http://localhost:5173
