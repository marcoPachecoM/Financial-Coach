GEMINI_API_KEY=your-gemini-api-key
# Optional (default gemini-4-hydrogen). A lighter model answers faster and is less often busy.
GEMINI_MODEL=gemini-flash-lite-latest
# Optional: chat messages per user (defaults 10 per minute, 100 per day).
# COPILOT_REQUESTS_PER_MINUTE=10
# COPILOT_DAILY_LIMIT=100
# Optional: model calls allowed for one message (tool loop; a normal question takes 2-3).
# COPILOT_MAX_LLM_CALLS=5

# --- JWT -------------------------------------------------------------------------------------
# Required outside dev. HS256 key of at least 32 bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
# Optional (defaults shown).
# JWT_ISSUER=financial-coach-api
# JWT_AUDIENCE=financial-coach-clients
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_REFRESH_TOKEN_TTL=14d

# --- Database --------------------------------------------------------------------------------
# Required outside dev (dev uses the local Docker database of compose.yaml).
DB_URL=jdbc:postgresql://localhost:5432/financial_coach
DB_USER=financial_coach
DB_PASSWORD=financial_coach

# --- Web -------------------------------------------------------------------------------------
# Optional (default http://localhost:5173). Comma-separated browser origins, never `*`.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limits on the token endpoints (requests per minute and IP) -------------------------
# RATE_LIMIT_LOGIN=5
# RATE_LIMIT_REFRESH=10
# RATE_LIMIT_LOGOUT=20
# Optional: failed logins of one email (from any IP) before each new attempt must wait (default 5).
# RATE_LIMIT_LOGIN_ACCOUNT_FAILURES=5

# --- Scheduled jobs --------------------------------------------------------------------------
# RECURRING_SCHEDULER_ENABLED=true
# RECURRING_CRON=0 5 0 * * *
# REFRESH_TOKEN_CLEANUP_CRON=0 30 3 * * *
